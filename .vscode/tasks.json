{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run dataset tiling",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "src/dataset.py",
        "--manifest",
        "data/manifest.csv",
        "--output_dir",
        "data/tiled",
        "--tile_size",
        "512"
      ],
      "problemMatcher": ["$python"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": false
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "tests/",
        "-v",
        "--tb=short"
      ],
      "problemMatcher": ["$python"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "isBackground": false
    },
    {
      "label": "Lint (Pylint)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pylint",
        "src/",
        "--disable=C0111,C0103"
      ],
      "problemMatcher": ["$python"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": false
    },
    {
      "label": "Format with Black",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "black",
        "src/",
        "tests/"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": false
    }
  ]
}
